# Postgres connection string (Vercel Postgres or Supabase both work — see README).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM key used to encrypt stored Meta/LinkedIn access tokens.
# Generate with: openssl rand -base64 32
# Rotating this key invalidates every already-stored token — reconnect
# accounts under Settings after rotating.
TOKEN_ENCRYPTION_KEY=""

# Password every user created by `npm run db:seed` gets (local/dev only).
SEED_PASSWORD="ChangeMe123!"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/publish. Set the same value in Vercel project settings.
CRON_SECRET=""

# From `vercel blob store add` / the Vercel dashboard, or `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# Meta App ID + Secret for the one-click "Connect with Facebook" button
# under Settings > Connected accounts. From developers.facebook.com >
# your app > Settings > Basic. You also need to add this app's exact
# callback URL under Facebook Login > Settings > Valid OAuth Redirect URIs:
#   http://localhost:3000/api/auth/meta/callback   (local dev)
#   https://<your-production-domain>/api/auth/meta/callback
META_APP_ID=""
META_APP_SECRET=""
